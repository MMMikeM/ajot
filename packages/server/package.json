{
  "name": "@newtab-todo/server",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./db/task.repo": "./src/db/task.repo.ts",
    "./db/category.repo": "./src/db/category.repo.ts",
    "./db/note.repo": "./src/db/note.repo.ts",
    "./db/contact.repo": "./src/db/contact.repo.ts",
    "./db/attachment.repo": "./src/db/attachment.repo.ts"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --on-success \"node --env-file=../../.env.dev --enable-source-maps dist/index.js\"",
    "start": "node dist/index.js",
    "test": "vp test run",
    "db:migrate": "node --env-file-if-exists=../../.env.dev src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:rehearse": "node src/db/rehearse.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@mmmike/web-push": "^1.5.0",
    "@newtab-todo/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "@tursodatabase/serverless": "^1.4.1",
    "drizzle-orm": "1.0.0-rc.4",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "vite-plus": "catalog:"
  }
}
