{
  "name": "@newtab-todo/server",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./db/task.repo": "./src/db/task.repo.ts",
    "./db/category.repo": "./src/db/category.repo.ts",
    "./db/note.repo": "./src/db/note.repo.ts",
    "./db/contact.repo": "./src/db/contact.repo.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx --env-file=../../.env.dev --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@mmmike/web-push": "^1.3.0",
    "@newtab-todo/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
