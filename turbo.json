{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["SERVER_URL", "VITE_VAPID_PUBLIC_KEY", "GITHUB_SHA"]
    },
    "build:ext": {
      "dependsOn": ["build"],
      "outputs": ["dist-extension/**"],
      "env": ["SERVER_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "fmt:check": {}
  }
}
