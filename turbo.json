{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:ext": {
      "dependsOn": ["build"],
      "outputs": ["dist-extension/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "fmt:check": {}
  }
}
