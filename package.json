{
  "name": "newtab-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:ext": "turbo build:ext",
    "start": "pnpm --filter @newtab-todo/server start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "check": "turbo typecheck && oxlint && oxfmt --check && knip",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "knip": "^6.3.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@11.0.0-beta.6"
}
