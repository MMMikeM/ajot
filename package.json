{
  "name": "newtab-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "build:ext": "vp run @newtab-todo/client#build:ext",
    "start": "pnpm --filter @newtab-todo/server start",
    "db:generate": "pnpm --filter @newtab-todo/server db:generate",
    "db:migrate": "pnpm --filter @newtab-todo/server db:migrate",
    "db:rehearse": "pnpm --filter @newtab-todo/server db:rehearse",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check && knip && pnpm deps:check",
    "deps:check": "depcruise packages/client/src packages/server/src packages/shared/src --config .dependency-cruiser.cjs",
    "dup": "jscpd",
    "screenshot": "pnpm --dir packages/e2e run screenshot",
    "test": "pnpm --filter @newtab-todo/server --filter @newtab-todo/client test",
    "test:e2e": "vp run @newtab-todo/e2e#test",
    "test:e2e:ui": "vp run @newtab-todo/e2e#test:ui",
    "test:e2e:prerender": "vp run @newtab-todo/e2e#test:prerender",
    "test:e2e:background": "vp run @newtab-todo/e2e#test:background",
    "reset-password": "vp run @newtab-todo/server#reset-password"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "jscpd": "^5.4.3",
    "knip": "^6.44.2",
    "typescript": "7.1.0-beta",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
