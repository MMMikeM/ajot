{
  "name": "newtab-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --env-mode=loose",
    "build": "turbo build",
    "build:ext": "turbo build:ext",
    "start": "pnpm --filter @newtab-todo/server start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "check": "turbo typecheck && oxlint && oxfmt --check && knip",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260403.1",
    "knip": "^6.3.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.3"
  },
  "overrides": {
    "serialize-javascript@<7.0.5": ">=7.0.5",
    "serialize-javascript@<=7.0.2": ">=7.0.3"
  },
  "packageManager": "pnpm@11.0.0-beta.6"
}
